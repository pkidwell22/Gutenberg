{
  "name": "scripture-library-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 64818 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run && node --test qa/*.test.mjs",
    "verify:live": "node qa/verify-library.mjs --base-url http://127.0.0.1:64817",
    "start": "tsx server/index.ts",
    "db:migrate": "tsx server/cli.ts migrate",
    "db:import": "tsx server/cli.ts import",
    "db:import-commentaries": "tsx server/cli.ts import-commentaries",
    "corpus:commentaries": "python3 ../tools/build_commentaries.py",
    "corpus:check": "python3 ../tools/build_corpus.py --check && python3 ../tools/build_commentaries.py --check",
    "test:corpus": "python3 -m unittest discover -s ../tests -p 'test_*.py' -v"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.8",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
