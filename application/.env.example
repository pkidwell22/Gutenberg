# Copy to .env and use a dedicated local database. Do not commit credentials.
# The parent-run local setup uses a private Unix socket and OS-user authentication.
DATABASE_URL=postgresql://YOUR_OS_USER@localhost:65432/scripture_library?host=YOUR_PERCENT_ENCODED_SOCKET_DIRECTORY
TEST_DATABASE_URL=postgresql://YOUR_OS_USER@localhost:65432/scripture_library_test?host=YOUR_PERCENT_ENCODED_SOCKET_DIRECTORY
PORT=64819
